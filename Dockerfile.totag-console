FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run platform:console:build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/console-dist ./console-dist
COPY --from=build /app/server/platform ./server/platform
COPY --from=build /app/shared ./shared
USER node
EXPOSE 4100
CMD ["node","server/platform/consoleServer.js"]
