# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL: use a separate database for development, staging, and production.
# Example shape only; replace with the internal host, database, and credentials
# from the matching Coolify PostgreSQL resource. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/redeemer_school"
# Runtime API pool must use the redeemer_runtime PostgreSQL role created by
# migration 003, with NOBYPASSRLS. Never set this to the postgres/admin account.
RUNTIME_DATABASE_URL="postgresql://redeemer_runtime:PASSWORD@POSTGRES_HOST:5432/redeemer_school"
APP_SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
AUTH_SESSION_TTL_MS="28800000"
DB_POOL_MAX="10"
PORT="3000"

# Transactional account invitation email. Keep the API key server-side and
# Runtime-only in Coolify; do not use a VITE_ variable for it.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Redeemer ERP Staging <staging@mail.redeemer.totag.network>"
APP_PUBLIC_URL="https://redeemer-staging.totag.network"
EMAIL_MODE="staging"
# Comma-separated inboxes you control, such as your address and test aliases.
# In staging, all other recipients are blocked.
EMAIL_ALLOWED_RECIPIENTS=""

# MTN MoMo Collections API. Keep these values server-side in Coolify secrets;
# never prefix them with VITE_ and never commit live credentials.
# SANDBOX is the safe default. Use PRODUCTION only after MTN enables the account.
MTN_MOMO_ENVIRONMENT="SANDBOX"
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_SUBSCRIPTION_KEY=""
# Production requests also require this explicit safety switch.
MTN_MOMO_ENABLE_LIVE_COLLECTIONS="false"
# MTN sandbox test transactions use EUR; Liberia production collections use LRD.
# Keep EUR in staging sandbox. Switch to LRD only in a production environment
# after MTN completes Liberia merchant onboarding.
MTN_MOMO_CURRENCY="EUR"
