# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL: use a separate database for development, staging, and production.
# Example shape only; replace with the internal host, database, and credentials
# from the matching Coolify PostgreSQL resource. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/redeemer_school"
# Runtime API pool must use the redeemer_runtime PostgreSQL role created by
# migration 003, with NOBYPASSRLS. Never set this to the postgres/admin account.
RUNTIME_DATABASE_URL="postgresql://redeemer_runtime:PASSWORD@POSTGRES_HOST:5432/redeemer_school"
APP_SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
# Generate once with `npm run keys:student-documents`, then store only as a
# Coolify server-side secret. Keep stable; replacing it locks existing files.
STUDENT_DOCUMENT_ENCRYPTION_KEY=""
AUTH_SESSION_TTL_MS="28800000"
DB_POOL_MAX="10"
PORT="3000"

# Transactional account invitation email. Keep the API key server-side and
# Runtime-only in Coolify; do not use a VITE_ variable for it.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Redeemer ERP Staging <staging@mail.redeemer.totag.network>"
APP_PUBLIC_URL="https://redeemer-staging.totag.network"
EMAIL_MODE="staging"

# MTN MoMo Collections API. Keep these values server-side in Coolify secrets;
# never prefix them with VITE_ and never commit live credentials.
# SANDBOX is the safe default. Use PRODUCTION only after MTN enables the account.
MTN_MOMO_ENVIRONMENT="SANDBOX"
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_SUBSCRIPTION_KEY=""
# Production requests also require this explicit safety switch.
MTN_MOMO_ENABLE_LIVE_COLLECTIONS="false"
# MTN sandbox test transactions use EUR; Liberia production collections use LRD.
# Keep EUR in staging sandbox. Switch to LRD only in a production environment
# after MTN completes Liberia merchant onboarding.
MTN_MOMO_CURRENCY="EUR"

# Orange Liberia SMS. One Orange account/API can send to all local networks,
# including MTN numbers. Keep client secret server-side in Coolify.
SMS_PROVIDER="ORANGE"
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
# Optional: only set a custom name if Orange has approved it for the account.
ORANGE_SMS_SENDER_NAME=""
# Optional: defaults to tel:+2310000 for Liberia.
ORANGE_SMS_SENDER_NUMBER=""

# MTN SMS V2 production. Set SMS_PROVIDER=MTN only after MTN approves the
# production sender address and confirms any charges. Keep live sending off
# until the account is ready; this is separate from MTN MoMo credentials.
MTN_SMS_CLIENT_ID=""
MTN_SMS_CLIENT_SECRET=""
MTN_SMS_SENDER_ADDRESS=""
MTN_SMS_ENABLE_LIVE="false"

# Browser web push. Generate with `npm run keys:vapid`; keep private key secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@totaggroup.com"

# Staging candidate sign-in preview. Requires reviewed migrations 104-109 and
# an explicitly approved test mailbox. Keep off until controlled staging validation.
ENABLE_CANDIDATE_EXAM_PREVIEW="false"
EMAIL_ALLOWED_RECIPIENTS=""
